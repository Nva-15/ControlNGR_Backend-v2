# =====================================================
# Control NGR - variables de entorno
# Copie este archivo como .env y complete los valores.
# El archivo .env NUNCA se sube a git.
# =====================================================

# ---- Base de datos ----
DB_NAME=controlngr
DB_USER=root
# Contraseña del usuario root de MySQL (escribirla sin comillas)
DB_PASSWORD=cambie_esta_clave
# Solo para ejecutar el backend fuera de Docker:
DB_HOST=localhost
DB_PORT=3307

# ---- Seguridad ----
# Minimo 32 caracteres aleatorios. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=36000

# ---- Correo (opcional) ----
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Sistema Control NGR

# ---- Puertos publicados (Docker) ----
# Puerto de la web (nginx). El backend no se publica.
APP_PORT=80
# MySQL solo escucha en 127.0.0.1 del servidor
DB_PUBLISHED_PORT=3307
# Ruta del repositorio del frontend (relativa a esta carpeta)
FRONTEND_DIR=../ControlNGR_Frontend-v2

# =====================================================
# Control NGR - variables de entorno
# Copie este archivo como .env y complete los valores.
# El archivo .env NUNCA se sube a git.
# =====================================================

# ---- Base de datos ----
DB_NAME=controlngr
DB_USER=controlngr
DB_PASSWORD=cambie_esta_clave
DB_ROOT_PASSWORD=cambie_esta_clave_root
# Solo para ejecutar el backend fuera de Docker:
DB_HOST=localhost
DB_PORT=3307

# ---- Seguridad ----
# Minimo 32 caracteres aleatorios. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=36000

# ---- Correo (opcional) ----
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Sistema Control NGR

# ---- Puertos publicados ----
APP_PORT=8080
DB_PUBLISHED_PORT=3307

# ---- Proxy (solo si hay nginx delante del backend) ----
# FORWARD_HEADERS_STRATEGY=native
# TRUSTED_PROXIES=172\\.\\d+\\.\\d+\\.\\d+
